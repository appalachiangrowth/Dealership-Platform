// Dealer Platform — PostgreSQL schema (replaces the old storage/*.json files)
//
// Old JSON file                              -> table
// storage/platform/users.json                -> PlatformOwner
// storage/platform/tenants.json              -> Tenant + TenantDomain
// storage/platform/settings.json             -> PlatformSetting
// storage/platform/theme-pricing.json        -> Theme (price fields)
// storage/platform/audit.log, tenants/*/audit.log -> AuditLog
// tenants/<id>/settings.json                 -> TenantSettings
// tenants/<id>/users.json                    -> DealerUser
// tenants/<id>/inventory.json  vehicles      -> Vehicle
// tenants/<id>/inventory.json  posts         -> BlogPost
// tenants/<id>/data/messages.json            -> Lead + LeadReply
// tenants/<id>/content.json (+ history)      -> ContentValue + ContentVersion
// tenants/<id>/design.json                   -> DesignColors
// tenants/<id>/data/theme-licenses.json      -> ThemeLicense + ThemeLicenseRequest
// tenants/<id>/data/field-rules.json         -> FieldRules
// tenants/<id>/data/cargurus/*               -> CargurusSubmission + CargurusLog
// tenants/<id>/uploads/*                     -> MediaFile (files stay on disk under backend/uploads/<tenant>/)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── enums ─────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ReleaseChannel {
  STABLE
  BETA
}

enum DealerRole {
  ADMIN
  STAFF
  INVENTORY
  LEADS
  MARKETING
  CUSTOM
}

enum AccountSource {
  SIGNUP
  PLATFORM
  DEALER
  SETUP
  MIGRATED
}

enum VehicleStatus {
  PUBLISHED
  DRAFT
  SOLD
}

enum PostStatus {
  PUBLISHED
  DRAFT
}

enum LeadStatus {
  UNREAD
  READ
  REPLIED
  CLOSED
}

enum LeadSource {
  CONTACT
  VEHICLE
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum LicenseRequestStatus {
  PENDING
  PAID
  DECLINED
}

enum CargurusStatus {
  PENDING
  APPROVED
  REJECTED
  REPLACED
}

enum SmtpSecurity {
  SSL
  TLS
  NONE
}

// ───────────────────────── platform ─────────────────────────

model PlatformOwner {
  id           String    @id @default(uuid())
  login        String    @unique
  name         String    @default("")
  email        String    @default("")
  passwordHash String
  disabled     Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// One row per settings group: smtp, keys, feeds, features, support, signup, payment
model PlatformSetting {
  group     String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Simple named counters (dealer codes AGS-1001, AGS-1002 …)
model Counter {
  name  String @id
  value Int
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actor     String   @default("")
  action    String
  detail    Json?
  ip        String   @default("")
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model LoginEvent {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  ownerId   String?
  login     String
  success   Boolean
  method    String   @default("password")
  ip        String   @default("")
  createdAt DateTime @default(now())

  tenant Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   DealerUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────── themes ─────────────────────────

model Theme {
  id            String         @id
  name          String
  description   String         @default("")
  style         String         @default("")
  author        String         @default("")
  previewUrl    String         @default("")
  /// colour slots the dealer can change: [{ key, label, default, hint }]
  colorSlots    Json
  stableVersion String         @default("1.0.0")
  betaVersion   String         @default("")
  // pricing (old theme-pricing.json)
  paid          Boolean        @default(false)
  price         Decimal        @default(0) @db.Decimal(10, 2)
  currency      String         @default("USD")
  billing       BillingCycle   @default(ONE_TIME)
  priceNote     String         @default("")
  enabled       Boolean        @default(true)
  /// private / custom theme: only the dealerships in allowedTenantIds see it in Design & colours (and can use it)
  isPrivate     Boolean        @default(false)
  /// dealership (tenant) ids allowed to see a private theme
  allowedTenantIds String[]    @default([])
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  versions        ThemeVersion[]
  licenses        ThemeLicense[]
  licenseRequests ThemeLicenseRequest[]
  designColors    DesignColors[]
}

model ThemeVersion {
  id         String   @id @default(uuid())
  themeId    String
  version    String
  notes      String   @default("")
  releasedAt DateTime @default(now())

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, version])
}

// ───────────────────────── tenants (dealerships) ─────────────────────────

model Tenant {
  id          String         @id // url-safe slug, e.g. "blue-motors"
  name        String
  dealerCode  String         @unique // AGS-1001 …
  status      TenantStatus   @default(ACTIVE)
  themeId     String         @default("classic")
  channel     ReleaseChannel @default(STABLE)
  themePin    String         @default("")
  /// earlier designs of this dealership (Platform Admin "Roll back last change"): [{ themeId, themePin, at, by }]
  themeHistory Json          @default("[]")
  /// per-dealer feature overrides, e.g. { "facebook": true, "cargurus": false }
  features    Json           @default("{}")
  notes       String         @default("")
  /// set-up checklist flags (old data/onboarding.json)
  onboarding  Json           @default("{}")
  /// optional custom lead form definition (old inventory.json → leadForm)
  leadForm    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  domains            TenantDomain[]
  settings           TenantSettings?
  users              DealerUser[]
  vehicles           Vehicle[]
  posts              BlogPost[]
  leads              Lead[]
  contentValues      ContentValue[]
  contentVersions    ContentVersion[]
  designColors       DesignColors[]
  themeLicenses      ThemeLicense[]
  licenseRequests    ThemeLicenseRequest[]
  fieldRules         FieldRules?
  media              MediaFile[]
  cargurusSubmission CargurusSubmission[]
  cargurusLogs       CargurusLog[]
  auditLogs          AuditLog[]
  loginEvents        LoginEvent[]
  fbAccounts         FbAccount[]
  fbCollections      FbCollection[]
  fbListings         FbListing[]
  fbPostRuns         FbPostRun[]
  sitePages          SitePage[]
  siteMenu           SiteMenu?
  seoPages           SeoPage[]
  seoVehicles        SeoVehicle[]
  seoRedirects       SeoRedirect[]
  deals              Deal[]
  stateFormTemplates StateFormTemplate[]
  seoSettings        SeoSettings?
  designRequests     DesignRequest[]
  visitorActivities  VisitorActivity[]

  @@index([status])
}

model TenantDomain {
  id        String   @id @default(uuid())
  tenantId  String
  domain    String   @unique // lower-case host, no port, e.g. "bluemotors.com"
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Business details + advanced settings (old tenants/<id>/settings.json)
model TenantSettings {
  tenantId String @id

  // business details
  name          String @default("")
  legalName     String @default("")
  tagline       String @default("")
  logo          String @default("")
  /// browser-tab icon of the dealer website (.ico / .png / .svg / .webp; "/uploads/…" or https://…); "" = the design's own
  faviconUrl    String @default("")
  phone         String @default("")
  email         String @default("")
  street        String @default("")
  city          String @default("")
  state         String @default("")
  stateName     String @default("")
  zip           String @default("")
  country       String @default("")
  lat           String @default("")
  lng           String @default("")
  /// { mon: { s: "open"|"closed", o: "09:00", c: "18:00" }, … }
  hours         Json   @default("{}")
  hoursWeek     String @default("")
  hoursWeekend  String @default("")
  hoursShort    String @default("")
  facebook      String @default("")
  instagram     String @default("")
  google        String @default("")
  googleReviews String @default("")
  youtube       String @default("")
  tiktok        String @default("")
  messenger     String @default("")
  siteUrl       String @default("")
  themeColor    String @default("#062B49")

  // inquiries & email
  leadTo       String       @default("")
  smtpHost     String       @default("")
  smtpPort     Int          @default(465)
  smtpSecure   SmtpSecurity @default(SSL)
  smtpUser     String       @default("")
  smtpPass     String       @default("") // write-only in the API
  smtpFrom     String       @default("")
  smtpFromName String       @default("")

  // photos
  maxUploadMb    Int     @default(12)
  brandImages    Boolean @default(true)
  brandBandColor String  @default("#EAF0F8")
  /// photo branding: the dealer's own band images ("" = automatic band drawn from Business details)
  brandHeader    String  @default("")
  brandFooter    String  @default("")
  /// branded photo url → { orig: clean copy url, src: original link, ver: bands version, lay: [CW, CH, HH, FH] }
  brandMap       Json    @default("{}")
  /// photo url → { at, reason } for photos that could not be branded
  brandFailed    Json    @default("{}")

  // feeds & CarGurus
  dealerCrmEmail     String  @default("")
  dealerCrmFormat    String  @default("text") // text | adf
  dealerRadius       String  @default("")
  feedOperation      String  @default("")
  feedCompleteBatch  String  @default("Y")
  feedToken          String  @default("") // write-only
  cargurusFtpHost    String  @default("")
  cargurusFtpUser    String  @default("")
  cargurusFtpPass    String  @default("") // write-only
  cargurusFtpPort    Int     @default(21)
  cargurusFtpSsl     Boolean @default(false)
  cargurusRemoteDir  String  @default("")
  cargurusRemoteName String  @default("inventory.csv")

  /// FB Poster › Marketplace settings (templates, daily limit, auto publish, AI writer); aiKey is write-only
  fbSettings Json @default("{}")

  // Deals / Bill of Sale (Business details): printed on the deal forms and used as defaults for a new deal
  dealerLicenseNumber String @default("")
  dealDocFee          String @default("")
  dealTaxRate         String @default("4.15")
  dealTitleFee        String @default("")

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DealerUser {
  id           String        @id @default(uuid())
  tenantId     String
  login        String // lower-case, usually the e-mail
  name         String        @default("")
  email        String        @default("")
  phone        String        @default("")
  role         DealerRole    @default(STAFF)
  /// only for role CUSTOM: hand-picked permissions (never "users")
  perms        String[]      @default([])
  passwordHash String
  disabled     Boolean       @default(false)
  source       AccountSource @default(DEALER)
  signupIp     String        @default("")
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loginEvents LoginEvent[]

  @@unique([tenantId, login])
  @@index([login])
}

// ───────────────────────── inventory ─────────────────────────

model Vehicle {
  id              String        @id @default(uuid())
  tenantId        String
  legacyId        String? // id from the old inventory.json (v179…)
  slug            String
  title           String        @default("")
  metaTitle       String        @default("")
  metaDescription String        @default("")
  year            Int?
  make            String        @default("")
  model           String        @default("")
  trim            String        @default("")
  vehicleType     String        @default("") // Car, Truck, SUV …
  bodyStyle       String        @default("")
  condition       String        @default("Used")
  certified       Boolean       @default(false)
  price           Decimal?      @db.Decimal(12, 2)
  msrp            Decimal?      @db.Decimal(12, 2)
  mileage         Int?
  stockNumber     String        @default("")
  vin             String        @default("")
  exteriorColor   String        @default("")
  interiorColor   String        @default("")
  engine          String        @default("")
  horsepower      String        @default("")
  drivetrain      String        @default("")
  transmission    String        @default("")
  fuelType        String        @default("")
  mpg             String        @default("")
  fuelTank        String        @default("")
  doors           String        @default("")
  seats           String        @default("")
  owners          String        @default("")
  accidents       String        @default("")
  dealLabel       String        @default("")
  description     String        @default("")
  features        String[]      @default([])
  safetyFeatures  String[]      @default([])
  /// ordered photo URLs: "/uploads/<tenant>/…" or absolute https links
  images          String[]      @default([])
  /// extra columns from the dealer's inventory file (header → value), kept for the CarGurus master CSV
  extra           Json          @default("{}")
  status          VehicleStatus @default(DRAFT)
  featured        Boolean       @default(false)
  /// where it goes besides the dealer's website (vehicle editor › "When you publish, it goes to"); both off = website only
  syndicateCargurus Boolean     @default(true)
  syndicateFacebook Boolean     @default(true)
  soldAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  fbListing FbListing?
  seo    SeoVehicle?
  deals  Deal[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, vin])
  @@index([tenantId, featured])
  @@index([tenantId, createdAt]) // inventory list "newest first"
}

/// Which vehicle fields are required (Inventory > Field rules)
model FieldRules {
  tenantId  String   @id
  /// { "vin": "required", "trim": "required", … }
  rules     Json     @default("{}")
  skipDraft Boolean  @default(true)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id              String     @id @default(uuid())
  tenantId        String
  legacyId        String?
  title           String
  slug            String
  excerpt         String     @default("")
  body            String     @default("")
  coverImage      String     @default("")
  category        String     @default("")
  tags            String[]   @default([])
  author          String     @default("")
  metaTitle       String     @default("")
  metaDescription String     @default("")
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
}

// ───────────────────────── leads ─────────────────────────

model Lead {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  email     String     @default("")
  phone     String     @default("")
  topic     String     @default("Website inquiry")
  message   String
  page      String     @default("")
  vehicleId String?
  source    LeadSource @default(CONTACT)
  status    LeadStatus @default(UNREAD)
  notes     String     @default("")
  emailed   Boolean    @default(false)
  /// anonymous website visitor id (pa_vid cookie) that sent this inquiry: links the lead to its browsing history
  visitorId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  replies    LeadReply[]
  activities VisitorActivity[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, visitorId])
}

model LeadReply {
  id        String   @id @default(uuid())
  leadId    String
  body      String
  sentBy    String   @default("")
  toEmail   String   @default("")
  fromEmail String   @default("")
  replyTo   String   @default("")
  emailed   Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// One thing a visitor did on a dealer website (storefront ActivityTracker → POST /public/track): a page or vehicle page
/// view, how far they scrolled, time on the page, a WhatsApp / call click, starting a form, sending an inquiry.
/// Anonymous (leadId null) until the same visitorId sends an inquiry; then every earlier row is linked to that lead.
/// eventType: PAGE_VIEW | VIEW_VDP | SCROLL_DEPTH | TIME_SPENT | WHATSAPP_CLICK | CALL_CLICK | FORM_START | LEAD_SUBMITTED
model VisitorActivity {
  id           String   @id @default(uuid())
  /// the dealership (Tenant.id is the dealer's slug)
  tenantId     String
  visitorId    String
  leadId       String?
  eventType    String
  vehicleId    String?
  vehicleTitle String?
  pagePath     String?
  /// 0–100
  scrollDepth  Int?
  durationSec  Int?
  city         String?
  region       String?
  userAgent    String?
  /// mobile | desktop
  deviceType   String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, visitorId])
  @@index([leadId])
  @@index([createdAt])
  @@index([eventType, createdAt])
}

// ───────────────────────── website content & design ─────────────────────────

/// One saved text per content key (see src/content/content.schema.ts)
model ContentValue {
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
}

/// Snapshot taken before every save (last 40 kept), used by "earlier versions"
model ContentVersion {
  id        String   @id @default(uuid())
  tenantId  String
  values    Json
  savedBy   String   @default("")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Brand colours, kept per theme so switching back restores them
model DesignColors {
  tenantId  String
  themeId   String
  /// { primary: "#0057B8", dark: "#062B49", … }
  colors    Json     @default("{}")
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([tenantId, themeId])
}

model ThemeLicense {
  id        String       @id @default(uuid())
  tenantId  String
  themeId   String
  amount    Decimal      @default(0) @db.Decimal(10, 2)
  currency  String       @default("USD")
  billing   BillingCycle @default(ONE_TIME)
  note      String       @default("")
  grantedBy String       @default("")
  requestId String?
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, themeId])
}

model ThemeLicenseRequest {
  id              String               @id @default(uuid())
  tenantId        String
  themeId         String
  status          LicenseRequestStatus @default(PENDING)
  requestedBy     String               @default("")
  requestedByName String               @default("")
  note            String               @default("")
  price           Decimal              @default(0) @db.Decimal(10, 2)
  currency        String               @default("USD")
  billing         BillingCycle         @default(ONE_TIME)
  reviewedBy      String               @default("")
  reviewNote      String               @default("")
  reviewedAt      DateTime?
  amountPaid      Decimal?             @db.Decimal(10, 2)
  createdAt       DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme  Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tenantId])
}

// ───────────────────────── media ─────────────────────────

model MediaFile {
  id           String   @id @default(uuid())
  tenantId     String
  url          String // public URL path, e.g. /uploads/blue-motors/2026/11/abc.jpg
  path         String // path on disk relative to backend/uploads
  mime         String
  size         Int
  width        Int?
  height       Int?
  originalName String   @default("")
  uploadedBy   String   @default("")
  createdAt    DateTime @default(now())
  /// Platform Admin › SEO & URLs › Images (attachment details). altText / title are added to this picture's <img>
  /// on the dealer website when the design gives none.
  altText       String    @default("")
  title         String    @default("")
  caption       String    @default("")
  description   String    @default("")
  metaUpdatedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, url])
}

// ───────────────────────── CarGurus pipeline ─────────────────────────

model CargurusSubmission {
  id             String         @id @default(uuid())
  tenantId       String
  status         CargurusStatus @default(PENDING)
  source         String         @default("upload") // upload | inventory
  fileName       String         @default("")
  /// validated rows: [{ _row, vin, make, …, _raw, _issues, _warn }]
  records        Json
  /// audit summary at upload time
  summary        Json
  rawText        String         @default("")
  createdBy      String         @default("")
  reviewedBy     String         @default("")
  reviewNote     String         @default("")
  reviewedAt     DateTime?
  /// last approved feed (CSV) that was sent / is served to CarGurus
  feedCsv        String?
  dispatchedAt   DateTime?
  dispatchResult Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
}

model CargurusLog {
  id        String   @id @default(uuid())
  tenantId  String
  event     String
  detail    Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ───────────────────────── FB Poster (Facebook groups / Pages / Marketplace) ─────────────────────────
// The Facebook login itself is NOT stored here: it lives in the server-side Chrome profile
// backend/storage/facebook/profiles/<dealership>/<user>/ (one per dealer user).

/// The Facebook account a dealer user connected, plus the Pages / groups found in it
model FbAccount {
  id           String    @id @default(uuid())
  tenantId     String
  /// dealer user id, or "owner-<id>" for a platform owner in support mode
  userKey      String
  fbUserId     String    @default("")
  fbName       String    @default("")
  connectedAt  DateTime?
  lastActiveAt DateTime?
  /// the Page this login currently posts as: { url, name } (empty = the personal profile)
  actingAs     Json      @default("{}")
  /// [{ name, url }]
  pages        Json      @default("[]")
  groups       Json      @default("[]")
  /// optional proxy for this login, e.g. http://user:pass@host:port
  proxy        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userKey])
}

/// Saved sets of groups (old collections.json), per Facebook login
model FbCollection {
  id          String   @id @default(uuid())
  tenantId    String
  userKey     String
  name        String
  /// { url, name } of the Page to post as first, or {}
  page        Json     @default("{}")
  includePage Boolean  @default(true)
  /// [{ name, url }]
  items       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userKey])
}

/// One Marketplace listing per inventory vehicle (old marketplace.json → vehicle.listing + listing copy)
model FbListing {
  id          String    @id @default(uuid())
  tenantId    String
  vehicleId   String    @unique
  /// none | queued | publishing | awaiting_publish | published | unconfirmed | failed | sold | removed
  status      String    @default("none")
  url         String    @default("")
  fbId        String    @default("")
  postedPrice Decimal?  @db.Decimal(12, 2)
  error       String    @default("")
  publishedAt DateTime?
  checkedAt   DateTime?
  /// userKey of the Facebook login that posted it (only that login can edit it on Facebook)
  postedBy    String    @default("")
  // listing text (title = first line of the Facebook description)
  title       String    @default("")
  description String    @default("")
  hashtags    String    @default("")
  copySource  String    @default("")
  /// Facebook's condition list (Excellent / Very good / Good / Fair / Poor); empty = from the vehicle
  fbCondition String    @default("")
  cleanTitle  Boolean   @default(true)
  /// [{ at, note }] newest first, last 30
  history     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// One "Start posting" run to groups / Pages
model FbPostRun {
  id         String    @id @default(uuid())
  tenantId   String
  userKey    String
  caption    String    @default("")
  media      Int       @default(0)
  /// [{ url, name, status, note, error }]
  results    Json      @default("[]")
  ok         Int       @default(0)
  failed     Int       @default(0)
  cancelled  Boolean   @default(false)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userKey, startedAt])
}

// ───────────────────────── custom website pages (Platform Admin › Pages & SEO) ─────────────────────────

enum SitePageStatus {
  DRAFT
  PUBLISHED
}

/// A page built from sections. It has no design of its own: the website renders it inside the dealership's
/// current theme (header, footer, fonts, brand colours), so it changes look when the theme changes.
model SitePage {
  id           String         @id @default(uuid())
  /// null = shown on every dealership's website; a dealership's own page with the same address wins
  tenantId     String?
  title        String
  /// address on the website: /<slug>
  slug         String
  status       SitePageStatus @default(DRAFT)
  /// working copy the editor saves: [{ id, type, tone, …fields }]
  sections     Json           @default("[]")
  /// what the website shows (copied from sections on Publish)
  published    Json?
  /// { title, description, image, noindex } — working copy / published copy
  seo          Json           @default("{}")
  publishedSeo Json?
  showInNav    Boolean        @default(true)
  navLabel     String         @default("")
  navOrder     Int            @default(0)
  publishedAt  DateTime?
  createdBy    String         @default("")
  updatedBy    String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([slug])
}

/// Platform Admin › Pages & SEO › Header menu: how the custom pages are arranged in a website's header —
/// top-level links and dropdowns. No row = automatic (every published page with "Show in the menu", by order).
model SiteMenu {
  id        String   @id @default(uuid())
  /// null = the menu of every dealership that has no menu of its own
  tenantId  String?  @unique
  /// [{ id, type: "page" | "group" | "link", slug?, url?, label, hidden, children: [{ id, type: "page" | "link", … }] }]
  items     Json     @default("[]")
  updatedBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ───────────────────────── SEO & URLs (Platform Admin › SEO & URLs) ─────────────────────────
// Additive tables only: nothing here changes how vehicles, feeds or the Dealership Portal work. With no rows a
// website looks and behaves exactly as before (design's own addresses, titles and descriptions).

/// Address + Google title / description of one standard website page of a dealership.
model SeoPage {
  id              String   @id @default(uuid())
  tenantId        String
  /// design page id (home, inventory, used-cars, about-us, contact-us, blog …) or "custom:<slug>" for a Pages & SEO page
  pageKey         String
  /// address without the leading "/" (e.g. "used-cars-for-sale"); null = the design's own address
  path            String?
  metaTitle       String   @default("")
  metaDescription String   @default("")
  ogTitle         String   @default("")
  ogDescription   String   @default("")
  ogImage         String   @default("")
  /// absolute URL; "" = the page's own clean address
  canonicalUrl    String   @default("")
  /// focus keyword(s): <meta name="keywords">
  mainKeyword     String   @default("")
  /// JSON-LD structured data (validated JSON, printed in a <script type="application/ld+json">)
  schemaMarkup    String   @default("")
  updatedBy       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pageKey])
  @@index([tenantId, path])
}

/// Clean vehicle address (/<inventory-base>/<slug>) + Platform Admin title / description overrides.
model SeoVehicle {
  vehicleId       String   @id
  tenantId        String
  /// year-make-model-trim (plus -<stock> only when another vehicle of the dealership already has it)
  slug            String
  /// true = typed in Platform Admin: "Regenerate clean slugs" leaves it alone
  slugLocked      Boolean  @default(false)
  metaTitle       String   @default("")
  metaDescription String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
}

/// Old addresses that answer with a 301. The target is looked up when the address is visited
/// (page:<pageKey> | vehicle:<vehicleId>), so renaming twice never builds a redirect chain.
/// Redirects of one dealership's website (the dealership = tenantId).
///  · automatic (manual = false): a changed page address / vehicle slug → "page:<key>" / "vehicle:<id>", always 301
///  · URL Redirects (manual = true, Platform Admin › SEO & URLs): sourcePath → destinationUrl with statusCode
///    301 / 302 / 307, or 410 Gone (no destination); isActive switches a rule off without deleting it
model SeoRedirect {
  id             String    @id @default(uuid())
  tenantId       String
  /// lookup key: old address without the leading "/"; vehicles: "@v/<old-slug>"; URL Redirects: "@m/<path>?<sorted query>"
  fromPath       String
  /// automatic redirects only
  target         String    @default("")
  manual         Boolean   @default(false)
  /// URL Redirects: the old URL as shown in Platform Admin ("/vehicle.html?id=123")
  sourcePath     String    @default("")
  /// URL Redirects: "/inventory/…" or "https://…"; null for 410
  destinationUrl String?
  /// 301 | 302 | 307 | 410
  statusCode     Int       @default(301)
  isActive       Boolean   @default(true)
  hits           Int       @default(0)
  lastHitAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromPath])
  @@index([tenantId, manual, createdAt])
  @@index([tenantId, sourcePath])
}

/// Per-dealership SEO settings: vehicle address base + vehicle title / description templates.
model SeoSettings {
  tenantId                   String   @id
  /// first part of every vehicle address: /<inventoryBase>/<vehicle-slug>
  inventoryBase              String   @default("inventory")
  /// earlier bases: their vehicle addresses 301 to the current base
  previousBases              String[] @default([])
  /// "" = platform default ({year} {make} {model} {trim} for Sale in {city}, {state} | {dealerName})
  vehicleTitleTemplate       String   @default("")
  vehicleDescriptionTemplate String   @default("")
  updatedBy                  String   @default("")
  updatedAt                  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Design requests (Dealer Portal › Design & colours → Platform Admin › Design requests) ─────────────────────────

enum DesignRequestType {
  EXTRA_PAGE
  EXTRA_SECTION
  DESIGN_CHANGE
}

/// the two tracks of Design & colours: "Add Pages" and "Add Custom Design / Theme"
enum DesignRequestCategory {
  ADD_PAGE
  CUSTOM_THEME
}

enum DesignRequestStatus {
  NEW
  IN_REVIEW
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum DesignContactPreference {
  PORTAL
  EMAIL
  PHONE
}

/// A dealership asks the platform team for an extra page, an extra section or a design change.
model DesignRequest {
  id                String                  @id @default(uuid())
  /// the dealership (shown as dealerId in the API)
  tenantId          String
  requestType       DesignRequestType
  /// null on requests sent before the two tracks: EXTRA_PAGE → ADD_PAGE, anything else → CUSTOM_THEME
  requestCategory   DesignRequestCategory?
  /// ADD_PAGE: "page"; CUSTOM_THEME: the main area (FULL_THEME, NEW_SECTION, COLORS_TYPOGRAPHY, HEADER_FOOTER, WIDGET_BANNER)
  subType           String                  @default("")
  /// CUSTOM_THEME: every area ticked
  designAreas       String[]                @default([])
  /// ADD_PAGE: slug idea, e.g. "service-department"
  pageSlug          String                  @default("")
  /// ADD_PAGE: CLEAN_INFO | LEAD_FOCUSED | MEDIA_GALLERY | MATCH_SITE
  layoutStyle       String                  @default("")
  /// ADD_PAGE: sections inside the page ("Hero Banner", "FAQ Accordion", custom ones…)
  requestedSections String[]                @default([])
  /// ADD_PAGE: text, headlines and details for the page
  contentNotes      String                  @default("")
  /// CUSTOM_THEME: { primary, accent, mode: light | dark | either, font }
  colorPreferences  Json?
  /// "Service Department Page", "Customer Testimonials Section"
  title             String
  /// "New navigation page", "Home page", "Vehicle detail page" …
  targetPage        String                  @default("")
  description       String
  referenceUrl      String                  @default("")
  contactPreference DesignContactPreference @default(PORTAL)
  contactEmail      String                  @default("")
  contactPhone      String                  @default("")
  status            DesignRequestStatus     @default(NEW)
  /// reply / status note from the platform team — the dealer sees it in the portal
  adminNotes        String                  @default("")
  /// login of the dealer user who sent it
  submittedBy       String                  @default("")
  /// platform owner who last updated it
  updatedBy         String                  @default("")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([requestCategory, createdAt])
  @@index([status, createdAt])
}

// ───────── Deals / Bill of Sale (dealer portal › Deals) ─────────

enum DealStatus {
  DRAFT
  COMPLETED
}

enum DealPaymentMethod {
  CASH
  FINANCE
  OUTSIDE_LIEN
}

enum OdometerStatus {
  ACTUAL
  EXCEEDS_LIMITS
  NOT_ACTUAL
}

enum WarrantyType {
  AS_IS
  WARRANTY
}

/// One vehicle sale: buyer, money, disclosures. The 4 forms (bill of sale, odometer statement, FTC Buyers Guide,
/// Virginia VSA 17A) are generated from it on demand (backend src/deals/pdf).
model Deal {
  id         String     @id @default(uuid())
  /// the dealership (tenant)
  tenantId   String
  vehicleId  String?
  /// 1, 2, 3 … per dealership; dealNumber = "D-000123"
  dealSeq    Int
  dealNumber String
  status     DealStatus @default(DRAFT)
  saleDate   DateTime   @default(now())

  // buyer
  buyerFullName      String @default("")
  buyerFirstName     String @default("")
  buyerMiddleName    String @default("")
  buyerLastName      String @default("")
  buyerEmail         String @default("")
  buyerPhone         String @default("")
  buyerAddress       String @default("")
  buyerCity          String @default("")
  buyerState         String @default("VA")
  buyerZip           String @default("")
  /// Virginia county / city of residence (VSA 17A)
  buyerCounty        String @default("")
  /// YYYY-MM-DD
  buyerDob           String @default("")
  buyerLicenseNumber String @default("")
  buyerLicenseState  String @default("VA")
  /// YYYY-MM-DD
  buyerLicenseExpiry String @default("")

  // co-buyer (optional)
  coBuyerFullName      String @default("")
  coBuyerAddress       String @default("")
  coBuyerPhone         String @default("")
  coBuyerLicenseNumber String @default("")

  // money
  salePrice        Decimal           @default(0) @db.Decimal(12, 2)
  tradeInAllowance Decimal           @default(0) @db.Decimal(12, 2)
  tradeInPayoff    Decimal           @default(0) @db.Decimal(12, 2)
  /// { year, make, model, vin, mileage }
  tradeInVehicle   Json              @default("{}")
  docFee           Decimal           @default(0) @db.Decimal(12, 2)
  titleRegFee      Decimal           @default(0) @db.Decimal(12, 2)
  otherFees        Decimal           @default(0) @db.Decimal(12, 2)
  otherFeesLabel   String            @default("")
  /// percent, e.g. 4.15
  salesTaxRate     Decimal           @default(4.15) @db.Decimal(6, 3)
  salesTaxAmount   Decimal           @default(0) @db.Decimal(12, 2)
  /// true = salesTaxAmount was typed by the dealer (not worked out from the rate)
  salesTaxManual   Boolean           @default(false)
  downPayment      Decimal           @default(0) @db.Decimal(12, 2)
  totalPrice       Decimal           @default(0) @db.Decimal(12, 2)
  balanceDue       Decimal           @default(0) @db.Decimal(12, 2)
  paymentMethod    DealPaymentMethod @default(CASH)
  lienholderName    String           @default("")
  lienholderAddress String           @default("")
  /// YYYY-MM-DD
  lienDate          String           @default("")

  // disclosures
  odometerReading        Int?
  odometerStatus         OdometerStatus @default(ACTUAL)
  warrantyType           WarrantyType   @default(AS_IS)
  /// FULL | LIMITED (dealer warranty only)
  warrantyKind           String         @default("LIMITED")
  warrantyDuration       String         @default("")
  warrantySystemsCovered String         @default("")
  warrantyLaborPct       String         @default("")
  warrantyPartsPct       String         @default("")
  serviceContract        Boolean        @default(false)
  stateCode              String         @default("VA")

  // Virginia VSA 17A
  /// TITLE_AND_REGISTRATION | TITLE_ONLY | TRANSFER_PLATE
  titlePurpose String @default("TITLE_AND_REGISTRATION")
  plateNumber  String @default("")
  gvwr         String @default("")

  /// the vehicle as it was sold (year, make, model, trim, VIN, colour …): the forms stay right if the vehicle changes
  vehicleSnapshot Json   @default("{}")
  notes           String @default("")
  createdBy       String @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dealSeq])
  @@index([tenantId, createdAt])
  @@index([vehicleId])
}

/// A state's official fillable PDF (Virginia DMV VSA 17A) filled from the deal instead of the built-in layout.
/// tenantId null = the platform's copy for every dealership (Platform Admin); a dealership's own copy wins.
model StateFormTemplate {
  id            String   @id @default(uuid())
  tenantId      String?
  stateCode     String   @default("VA")
  formName      String   @default("Virginia DMV VSA 17A - Application for Certificate of Title and Registration")
  /// "/uploads/…" path of the PDF
  pdfUrl        String
  /// every AcroForm field of the PDF: [{ name, type }]
  pdfFields     Json     @default("[]")
  /// PDF field name → deal key (see backend src/deals/deal-keys.ts)
  fieldMappings Json     @default("{}")
  isActive      Boolean  @default(true)
  uploadedBy    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stateCode])
}
