        "also": [
          "--home-accent",
          "--hub-accent",
          "--color-primary-bright"
        ],
        "hint": "Highlights, glows and highlighted words"
      },
      {
        "var": "--asphalt",
        "label": "Dark background",
        "default": "#080A16",
        "also": [
          "--home-dark",
          "--hub-navy",
